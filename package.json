{
  "name": "@verticesandedges/graph-element",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.3",
  "description": "A 3D Graph Visualization Web Component",
  "keywords": [
    "3D",
    "Graph",
    "Visualization",
    "Web",
    "Component"
  ],
  "homepage": "https://github.com/verticesandedges/graph-element#readme",
  "bugs": {
    "url": "https://github.com/verticesandedges/graph-element/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/verticesandedges/graph-element.git"
  },
  "license": "MIT",
  "author": "Joshua M. Moore <joshua.moore@verticesandedges.net>",
  "type": "module",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "types": "docs/types.d.ts",
  "targets": {
    "main": {
      "isLibrary": true,
      "includeNodeModules": true,
      "context": "browser",
      "outputFormat": "esmodule"
    },
    "demo": {
      "source": "src/index.html",
      "distDir": "docs/demo",
      "engines": {
        "browsers": "> 0.5%, last 2 versions, not dead"
      }
    },
    "test_page": {
      "source": "test/index.html",
      "distDir": "docs/test",
      "engines": {
        "browsers": "> 0.5%, last 2 versions, not dead"
      }
    }
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "watch:lib": "parcel watch --target main",
    "watch:demo": "parcel watch --target demo",
    "watch:test": "parcel watch --target test_page",
    "build:lib": "parcel build --target main",
    "build:demo": "parcel build --target demo",
    "build:test": "parcel build --target test_page",
    "build": "parcel build --target main && parcel build --target demo && parcel build --target test_page",
    "start:demo": "http-server docs/demo/ -c-1",
    "start:test": "http-server docs/test -c-1",
    "clean": "rm -rf .parcel-cache/ docs/ dist/",
    "test": "web-test-runner --config web-test-runner.config.js"
  },
  "dependencies": {
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@parcel/packager-ts": "^2.16.4",
    "@parcel/transformer-typescript-tsc": "^2.16.4",
    "@parcel/transformer-typescript-types": "^2.16.4",
    "@types/chai": "^5.2.3",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/three": "^0.183.1",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "buffer": "^6.0.3",
    "chai": "^6.2.2",
    "events": "^3.3.0",
    "jsdom": "^30.0.1",
    "mocha": "^11.3.0",
    "parcel": "latest",
    "path-browserify": "^1.0.1",
    "playwright": "^1.63.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "util": "^0.12.5"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
